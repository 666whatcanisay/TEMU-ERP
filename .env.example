# WORKBENCH_DATA_DIR=/absolute/path/to/workbench-data
WORKBENCH_MODE=fully_managed
WORKBENCH_LIVE_PLATFORM_WRITE=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DSH_BASE_URL=
DSH_MAX_TASKS=6
DSH_CONCURRENCY=1
