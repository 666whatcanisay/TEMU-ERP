# No secrets are included. Empty providers remain not_configured.
# 默认使用项目目录下的 data/；需要自定义时通过进程环境变量设置绝对路径。
# WORKBENCH_DATA_DIR=/absolute/path/to/workbench-data
WORKBENCH_DB_DRIVER=mysql
WORKBENCH_MYSQL_HOST=127.0.0.1
WORKBENCH_MYSQL_PORT=3306
WORKBENCH_MYSQL_DATABASE=temu_workbench
WORKBENCH_MYSQL_USER=temu_workbench_app
WORKBENCH_MYSQL_PASSWORD=
WORKBENCH_MODE=fully_managed
WORKBENCH_LIVE_PLATFORM_WRITE=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DSH_BASE_URL=
DSH_MAX_TASKS=6
DSH_CONCURRENCY=1
